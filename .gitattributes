# Normalize all text files to LF on commit
* text=auto eol=lf

# Source
*.java    text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.properties text eol=lf
Makefile  text eol=lf

# Binary — never diff or merge as text
*.jar     binary
*.gif     binary
*.png     binary
*.class   binary
